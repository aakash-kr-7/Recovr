# ==============================================================================
# RECOVR - Git Ignore Specification
# ==============================================================================

# ---- Environment & secrets ----
.env
.env.*
!.env.example
.env.local
.env.*.local
.envrc
.secrets/
*.pem
*.key
*.cert
*.crt

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
develop-eggs/
downloads/
eggs/
.tox/
.nox/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.cache/
**/.cache/
htmlcov/
.coverage
.coverage.*

# ---- Node & frontend ----
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
frontend/dist/
frontend/build/
.vite/
**/.vite/
.turbo/
coverage/
playwright-report/
*.tsbuildinfo
**/*.tsbuildinfo
# TypeScript emits alongside vite.config.ts when build mode is used
vite.config.js
**/vite.config.js
vite.config.d.ts
**/vite.config.d.ts
vite.config.js.map
**/vite.config.js.map
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Database & generated data ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
app.db
**/app.db
backend/app.db

# Evaluation data partitions
backend/data/eval/*.json
backend/data/eval/*.csv
!backend/data/eval/.gitkeep
# Frozen evidence required to reproduce the canonical synthetic evaluation
!backend/data/eval/holdout.json
!backend/data/eval/latest_report.json

# ---- Logs ----
*.log
**/*.log
logs/
**/logs/

# ---- OS & Filesystem Metadata ----
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~
.directory

# ---- Editors & IDEs ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- Razorpay / API keys safety net ----
razorpay_keys*.json
secrets.json
credentials.json
service_account*.json

# ---- Scratch, AI tools & Temporary ----
scratch/
**/scratch/
.tmp/
**/.tmp/
.temp/
**/.temp/
*.tmp
*.bak
*.swp
*.swo
.gemini/
.agents/
