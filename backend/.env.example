# Razorpay TEST MODE keys only. Never put live keys in this project.
# Get these from: Razorpay Dashboard -> Settings -> API keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret configured in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for the reasoning path
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# LLM Provider selection (anthropic or groq)
LLM_PROVIDER=groq

# Groq API key (used if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=15

# Database
DATABASE_URL=sqlite:///./app.db

# Cost constants used by the evaluation report.
# Source: see docs/decisions/0004-baseline-sourcing.md before changing this.
WASTED_RETRY_COST_INR=8.0

# Bounded executor spend cap for a single evaluation batch (INR)
BATCH_SPEND_CAP_INR=50000

# Confidence threshold below which a reasoning-path decision is routed
# to hold_for_review instead of auto-executing (0.0 - 1.0)
MIN_AUTO_EXECUTE_CONFIDENCE=0.75
MAX_CUSTOMER_RECOVERY_ATTEMPTS=2

# App environment
ENVIRONMENT=development
LOG_LEVEL=INFO
